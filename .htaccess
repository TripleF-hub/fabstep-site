# ==========================================================================
# FabStep — configuration Apache pour l'hébergement web Hostinger (option B)
# Inutile sur GitHub Pages (fichier ignoré là-bas).
# ==========================================================================

# ---------- 1. Forcer HTTPS et l'adresse sans « www » ----------
RewriteEngine On

# http:// → https://
RewriteCond %{HTTPS} off
RewriteRule ^ https://fabstep.app%{REQUEST_URI} [L,R=301]

# www.fabstep.app → fabstep.app
RewriteCond %{HTTP_HOST} ^www\.fabstep\.app$ [NC]
RewriteRule ^ https://fabstep.app%{REQUEST_URI} [L,R=301]

# /index.html → / (une seule adresse pour l'accueil)
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [L,R=301]

# Les fichiers de travail (_sources) ne sont pas publics
RewriteRule ^_sources(/|$) - [F,L]

# ---------- 2. Page d'erreur personnalisée ----------
ErrorDocument 404 /404.html

# Pas de liste des fichiers dans les dossiers
Options -Indexes

# ---------- 3. Types de fichiers ----------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddCharset utf-8 .html .css .txt .xml
</IfModule>

# ---------- 4. En-têtes de sécurité ----------
<IfModule mod_headers.c>
  # HTTPS obligatoire pendant 1 an (le domaine .app l'impose déjà dans les navigateurs)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  # Aucune ressource externe autorisée : garantit l'absence de traceur.
  # Le hash sha256 autorise UNIQUEMENT le petit style interne du composant fabstep-walker.js
  # (à recalculer si ce fichier change : voir README)
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'sha256-E4nDfccnyWieRNjKxlFhA+ssXJFsrkwvZIJTUjo/vTA='; font-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
</IfModule>

# ---------- 5. Cache navigateur ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType text/javascript "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ---------- 6. Compression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript text/plain text/xml application/xml image/svg+xml
</IfModule>
